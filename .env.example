NODE_ENV=development
PORT=8000
# Replica set required. See docker-compose.yml for a local database.
MONGODB_URI=mongodb://127.0.0.1:27017/hcm_lite?replicaSet=rs0&directConnection=true
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
LOG_LEVEL=info
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-3.5-flash-lite
AI_API_KEY=
# Optional explicit CLI bootstrap only (never automatically seeds):
COMPANY_NAME=My Company
ADMIN_EMAIL=
ADMIN_PASSWORD=
